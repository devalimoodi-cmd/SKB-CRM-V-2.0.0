# ============================================================
#  نمونهٔ فایل تنظیمات بک‌اند
#  این فایل را به نام «.env» در پوشهٔ Backend کپی کنید و مقادیر
#  واقعی را بگذارید. (فایل .env هرگز در گیت ذخیره نمی‌شود)
# ============================================================

# ===== سرور =====
PORT=5000
# روی سرور مقدار production بگذارید تا جزئیات خطاهای داخلی به کاربر لو نرود
NODE_ENV=production

# ===== دیتابیس PostgreSQL =====
DB_HOST=localhost
DB_PORT=5432
DB_NAME=SKB-CRM
DB_USER=postgres
DB_PASSWORD=

# ===== احراز هویت (JWT) =====
# یک رشتهٔ تصادفی و طولانی (مثلاً ۶۴ کاراکتر) بگذارید
JWT_SECRET=CHANGE_ME_random_long_secret
# عمر توکن: "30m" , "12h" , "7d" , "24h" ...
# هرچه کوتاه‌تر، امن‌تر (کاربران زودتر باید دوباره وارد شوند). پیشنهاد: 24h
JWT_EXPIRE=7d

# ✅ فقط یک نشست فعال برای هر کاربر
# با true شدن: هر ورود جدید، نشست قبلی را باطل می‌کند و «خروج» فوراً توکن را بی‌اعتبار می‌کند.
# پیش‌فرض false است تا کاربرانی که همزمان از موبایل و کامپیوتر استفاده می‌کنند بیرون نیفتند.
ENFORCE_SINGLE_SESSION=false

# ✅ قفل حساب پس از تلاش‌های ورود ناموفق
# بعد از این تعداد رمز اشتباه، حساب برای مدت زیر قفل می‌شود
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=30

# ✅ هدر HSTS (فقط بعد از راه‌اندازی HTTPS مقدار true بده)
ENABLE_HSTS=false

# ===== کپچای صفحهٔ ورود =====
CAPTCHA_ENABLED=true
CAPTCHA_LENGTH=5
CAPTCHA_TTL_MINUTES=5
# ⚠️ فقط برای تست/دیباگ محلی (در production بی‌اثر است: پاسخ درست را برمی‌گرداند)
CAPTCHA_DEBUG=false

# ✅ مسیر pg_dump (فقط اگر جای غیرمعمولی نصب است؛ برای npm run db:schema)
# PG_DUMP_PATH=C:\Program Files\PostgreSQL\18\bin\pg_dump.exe

# ===== پیامک (sms.ir) =====
SMS_API_KEY=
SMS_API_KEY_SANDBOX=
SMS_MODE=production
SMS_DEFAULT_LINE=
SMS_TEMPLATE_WEEK_REGISTER=760288
SMS_TEMPLATE_WEEK_REMINDER=102017

# ===== آب‌وهوا (داشبورد) =====
# مدت اعتبار کش آب‌وهوا به دقیقه (0 = بدون کش). کش برای اینترنت ضعیف کارخانه مفید است.
WEATHER_CACHE_MINUTES=20
# حداکثر زمان انتظار برای سرویس آب‌وهوا (میلی‌ثانیه)
WEATHER_TIMEOUT_MS=8000

# ===== بکاپ‌گیری (npm run backup / backup.bat) =====
# تعداد نسخه‌های نگه‌داشته‌شده در پوشهٔ بکاپ (پیش‌فرض 7)
BACKUP_KEEP=7
# مسیر پوشهٔ بکاپ (پیش‌فرض: <ریشهٔ پروژه>\backups)
# BACKUP_DIR=D:\SKB-Backups
# ✅ مهم: کپی خودکار هر بکاپ روی دیسک دوم یا درایو شبکه
# بدون این تنظیم، خرابی همان دیسک = از دست رفتن دیتابیس و بکاپ‌ها با هم
# BACKUP_COPY_TO=E:\SKB-Backups

# ✅ اگر 1 باشد، فایل deploy.bat قبل از اجرای مایگریشن خودش بکاپ می‌گیرد
# (برای استقرار روی سرور توصیه می‌شود)
BACKUP_BEFORE_MIGRATE=1

# ===== ⛔ همگام‌سازی مدل‌ها (legacy — معمولاً لازم نیست) =====
# قاعده: هرگز sequelize.sync نزن. ساخت/به‌روزرسانی ساختار دیتابیس فقط با:
#     npm run db:migrate   &&   npm run db:verify
# این متغیر فقط برای اجرای اسکریپت قدیمی scripts/sync-db.js است (فقط بعد از بکاپ،
# و روی production هرگز اجرا نمی‌شود):
# ALLOW_DB_SYNC=true

# ===== تغییرات جدید / What's New =====
# حداکثر تعداد آیتم (تغییر) در هر نسخه (پیش‌فرض 50، سقف 200)
RELEASE_NOTE_MAX_ITEMS=50

# ===== شمارهٔ مشتری (customer_code) =====
# شمارهٔ مشتری از این عدد شروع می‌شود و ترتیبی است (بزرگ‌ترین شماره + ۱)
CUSTOMER_CODE_START=1000

# ===== سطوح دسترسی (نقش‌ها و کاربران) =====
# کاتالوگ مجوزها در Backend/config/permissions.js است و ادمین از پنل مدیریت
# (بخش «مدیریت نقش‌ها») هر مجوز را برای هر نقش/کاربر روشن یا خاموش می‌کند.
#
# ⚠️ حالت اجرا:
#   false (پیش‌فرض) = «حالت آزمایشی / dry-run»
#       هیچ درخواستی بلاک نمی‌شود؛ فقط در لاگ سرور ثبت می‌شود که
#       «چه کسی، چه مسیری، فاقد چه مجوزی بود» — برای بررسی قبل از فعال‌سازی.
#   true = کنترل واقعی؛ درخواست‌های فاقد مجوز ۴۰۳ می‌گیرند.
#       پیشنهاد: چند روز با false اجرا کنید، لاگ‌ها را ببینید، سپس true کنید.
PERMISSIONS_ENFORCE=false
# مدت کش مجوزها (میلی‌ثانیه). پیش‌فرض 30000 (۳۰ ثانیه).
# تغییرات پنل مدیریت بلافاصله اعمال می‌شود (کش همان لحظه پاک می‌شود)؛
# این کش فقط برای سبک‌شدن درخواست‌های پشت‌سرهم است.
PERMISSIONS_CACHE_TTL_MS=30000

# ===== حضور کاربران (Presence — «چه کسی آنلاین است») =====
# رفع باگ «آنلاین همیشه»: قبلاً وضعیت آنلاین فقط در ورود/خروج ست می‌شد و اگر
# کاربر مرورگر را می‌بست یا اینترنت/برق قطع می‌شد، تا ابد آنلاین می‌ماند.
# حالا: کاربر آنلاین است اگر صریحاً آفلاین نباشد و آخرین فعالیتش «تازه» باشد.
#
# پنجرهٔ آنلاین (ثانیه): اگر این مدت هیچ فعالیتی از کاربر ثبت نشود → آفلاین
PRESENCE_ONLINE_WINDOW_SECONDS=120
# حداکثر یک‌بار در این بازه (ثانیه) «آخرین فعالیت» در دیتابیس نوشته می‌شود
# (هر درخواست احراز‌شده یک بار؛ این throttle جلوی سیل UPDATE را می‌گیرد)
PRESENCE_TOUCH_THROTTLE_SECONDS=60
# بازهٔ heartbeat فرانت‌اند (ثانیه) — باید دست‌کم نصفِ پنجرهٔ آنلاین باشد
# (وگرنه کاربرِ واقعاً فعال بین دو heartbeat «آفلاین» دیده می‌شود)
PRESENCE_HEARTBEAT_SECONDS=45

# ===== نگهداری فایل‌های آپلودی =====
# فایل‌های «یتیم» تازه‌تر از این مدت (ساعت) حذف نمی‌شوند (پیش‌فرض 24)
ORPHAN_MIN_AGE_HOURS=24
# الگوهای «دارایی ثابت» (regex، جدا با کاما) که هرگز یتیم/قابل‌حذف حساب نمی‌شوند
# الگوهای پیش‌فرض: avatar-N.jpg، default-avatar.*، .gitkeep، .gitignore، README*
# UPLOADS_KEEP_PATTERNS=^logo-.*\.png$,^static-.*\.jpg$

# ===== امنیت: محدودیت نرخ درخواست (اختیاری) =====
# حداکثر درخواست هر آی‌پی در هر دقیقه برای همهٔ APIها
API_RATE_MAX=1200
# حداکثر تلاش ورود ناموفق هر آی‌پی در بازهٔ زیر
LOGIN_RATE_MAX=30
LOGIN_RATE_WINDOW_MINUTES=15
# حداکثر تلاش برای ساخت ادمین اولیه در هر ساعت
SETUP_ADMIN_RATE_MAX=5
# محدودیت ارسال «نظرات و پیشنهادات» (هر آی‌پی)
SUGGESTION_RATE_MAX=20
SUGGESTION_RATE_WINDOW_MINUTES=15
# فقط برای تست: true بگذارید تا محدودیت‌ها غیرفعال شوند
RATE_LIMIT_DISABLED=false
