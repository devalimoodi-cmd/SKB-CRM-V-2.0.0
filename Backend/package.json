{
  "name": "backend",
  "version": "1.0.0",
  "description": "SKB-CRM API (Express + Sequelize + PostgreSQL)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "check": "node --check server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:security": "node security-unit-test.mjs && node security-api-test.mjs",
    "test:db": "node security-e2e-test.mjs",
    "test:uploads": "node priority34-test.mjs",
    "test:integrity": "node data-integrity-test.mjs",
    "test:uploads-maint": "node uploads-maintenance-test.mjs",
    "test:customer-validation": "node customer-validation-test.mjs",
    "verify": "npm run check && npm run lint && npm run test:security",
    "backup": "node scripts/backup.js",
    "uploads:report": "node scripts/uploads-report.js",
    "uploads:clean": "node scripts/clean-orphan-uploads.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:rollback": "sequelize-cli db:migrate:undo",
    "db:status": "sequelize-cli db:migrate:status",
    "db:seed": "sequelize-cli db:seed:all",
    "db:schema": "node scripts/dump-schema.js",
    "db:verify": "node scripts/verify-db.js",
    "db:sync": "node scripts/sync-db.js",
    "db:reset-sequences": "node scripts/reset-sequences.js",
    "db:seed-unit-statuses": "node scripts/seed-unit-statuses.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "axios": "^1.18.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "pg": "^8.20.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "eslint": "^10.10.0",
    "nodemon": "^3.1.14",
    "sequelize-cli": "^6.6.5"
  }
}
